{
  "info": {
    "_postman_id": "d58a7388-f082-49e9-99c5-67f6f43b3a31",
    "name": "Community Emergency Response - Milestone 3",
    "description": "Authenticated API checks for incident reports, assignment/history, SOS, and recipient-private notifications. Populate variables from a local/test deployment; never store real passwords or session keys in a shared collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8001" },
    { "key": "identifier", "value": "" },
    { "key": "password", "value": "", "type": "secret" },
    { "key": "csrf_token", "value": "" },
    { "key": "tab_session", "value": "", "type": "secret" },
    { "key": "authenticated_user_id", "value": "" },
    { "key": "report_id", "value": "" },
    { "key": "volunteer_id", "value": "" },
    { "key": "sos_id", "value": "" },
    { "key": "notification_id", "value": "" },
    { "key": "idempotency_key", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{tab_session}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get CSRF token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/api/auth/csrf/"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('CSRF bootstrap returns 200', function () { pm.response.to.have.status(200); });",
                "pm.environment.set('csrf_token', pm.response.json().csrfToken);"
              ]
            }
          }]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRFToken", "value": "{{csrf_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"identifier\":\"{{identifier}}\",\"password\":\"{{password}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/auth/login/"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Login succeeds', function () { pm.response.to.have.status(200); });",
                "pm.test('Response contains authenticated identity and session', function () {",
                "  const body = pm.response.json();",
                "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                "  pm.expect(body.user).to.have.property('id');",
                "  pm.environment.set('tab_session', body.token);",
                "  pm.environment.set('authenticated_user_id', body.user.id);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Current authenticated user",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/auth/me/"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Current user is returned', function () { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.have.property('role'); });"
              ]
            }
          }]
        },
        {
          "name": "Logout current tab session",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-CSRFToken", "value": "{{csrf_token}}" }],
            "url": "{{base_url}}/api/auth/logout/"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Current session is revoked', function () { pm.response.to.have.status(200); });",
                "pm.environment.unset('tab_session');"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "Emergency reports",
      "item": [
        {
          "name": "Create report",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRFToken", "value": "{{csrf_token}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Kitchen smoke\",\"incident_type\":\"FIRE\",\"location\":\"Block A entrance\",\"description\":\"Smoke is visible near the kitchen.\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/reports/api/reports/"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Report is created', function () { pm.response.to.have.status(201); });",
                "pm.test('Creator is the authenticated user', function () {",
                "  const body = pm.response.json();",
                "  pm.expect(body.reporter).to.eql(Number(pm.environment.get('authenticated_user_id')));",
                "  pm.environment.set('report_id', body.id);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "List visible reports",
          "request": { "method": "GET", "url": "{{base_url}}/reports/api/reports/" },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Visible reports are returned', function () { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"
              ]
            }
          }]
        },
        {
          "name": "Invalid report is rejected",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRFToken", "value": "{{csrf_token}}" }],
            "body": { "mode": "raw", "raw": "{\"incident_type\":\"UNKNOWN\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/reports/api/reports/"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Invalid report returns validation errors', function () { pm.response.to.have.status(400); });"]
            }
          }]
        },
        {
          "name": "List available volunteers (admin only)",
          "request": { "method": "GET", "url": "{{base_url}}/reports/api/volunteers/" },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Admin receives verified available volunteers', function () { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });",
                "if (pm.response.code === 200 && pm.response.json().length) pm.environment.set('volunteer_id', pm.response.json()[0].id);"
              ]
            }
          }]
        },
        {
          "name": "Acknowledge report (security/admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRFToken", "value": "{{csrf_token}}" }],
            "body": { "mode": "raw", "raw": "{\"status\":\"ACKNOWLEDGED\",\"response_notes\":\"Security team is responding.\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/reports/api/reports/{{report_id}}/status/"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Report acknowledgement succeeds', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ACKNOWLEDGED'); });"]
            }
          }]
        },
        {
          "name": "Assign report volunteer (admin only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRFToken", "value": "{{csrf_token}}" }],
            "body": { "mode": "raw", "raw": "{\"volunteer_id\":{{volunteer_id}}}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/reports/api/reports/{{report_id}}/assign/"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Report is assigned and history status changes', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); pm.expect(pm.response.json().status).to.eql('ASSIGNED'); });"]
            }
          }]
        },
        {
          "name": "Read report history",
          "request": { "method": "GET", "url": "{{base_url}}/reports/api/reports/{{report_id}}/history/" },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Report history is returned', function () { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"]
            }
          }]
        }
      ]
    },
    {
      "name": "SOS and notifications",
      "item": [
        {
          "name": "Create SOS (idempotent)",
          "event": [{
            "listen": "prerequest",
            "script": { "type": "text/javascript", "exec": ["if (!pm.environment.get('idempotency_key')) pm.environment.set('idempotency_key', pm.variables.replaceIn('{{$guid}}'));"] }
          }, {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('SOS is saved', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                "pm.test('SOS reporter is authenticated user', function () {",
                "  const body = pm.response.json();",
                "  pm.expect(body.reporter).to.eql(Number(pm.environment.get('authenticated_user_id')));",
                "  pm.environment.set('sos_id', body.id);",
                "});"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRFToken", "value": "{{csrf_token}}" },
              { "key": "Idempotency-Key", "value": "{{idempotency_key}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"category\":\"MEDICAL\",\"message\":\"Immediate assistance needed\",\"location_text\":\"Block A entrance\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/alerts/api/sos/"
          }
        },
        {
          "name": "List SOS alerts",
          "request": { "method": "GET", "url": "{{base_url}}/alerts/api/sos/list/" },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Visible SOS alerts are returned', function () { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"]
            }
          }]
        },
        {
          "name": "Get notification inbox",
          "request": { "method": "GET", "url": "{{base_url}}/alerts/api/notifications/" },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Only this session inbox is returned', function () { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });",
                "if (pm.response.code === 200 && pm.response.json().length) pm.environment.set('notification_id', pm.response.json()[0].id);"
              ]
            }
          }]
        },
        {
          "name": "Unread notification count",
          "request": { "method": "GET", "url": "{{base_url}}/alerts/api/notifications/unread-count/" },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Unread count is returned', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().count).to.be.a('number'); });"]
            }
          }]
        },
        {
          "name": "Mark one owned notification read",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "X-CSRFToken", "value": "{{csrf_token}}" }],
            "url": "{{base_url}}/alerts/api/notifications/{{notification_id}}/read/"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Owned notification is marked read', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('READ'); });"]
            }
          }]
        },
        {
          "name": "Mark all owned notifications read",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "X-CSRFToken", "value": "{{csrf_token}}" }],
            "url": "{{base_url}}/alerts/api/notifications/read-all/"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Owned unread notifications are marked read', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().updated).to.be.a('number'); });"]
            }
          }]
        },
        {
          "name": "Unauthenticated report list is rejected",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/reports/api/reports/"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Unauthenticated request is rejected', function () { pm.response.to.have.status(401); });"]
            }
          }]
        }
      ]
    }
  ]
}
